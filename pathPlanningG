    # Every line below was individually verified (by actually re-running
    # BFS with that one edge opened) to connect START_CELL=(1,7) all the
    # way through to GOAL_CELL=(7,1) -- opening any ONE of them is enough.
    # ((7, 4), "E"): False,   # opens edge to (7, 5)
