CORNER_COLOR_RANGES = {
    "pink":   [(np.array([160, 25, 90]),  np.array([180, 255, 255])),
               (np.array([0,   25, 90]),  np.array([8,   255, 255]))],
    "orange": [(np.array([5,   120, 55]), np.array([18,  255, 255]))],
    "purple": [(np.array([100, 60, 60]),  np.array([130, 255, 255]))],
    "yellow": [(np.array([18,  120, 30]), np.array([32,  255, 255]))],
}


def load_and_crop(image_path):
    img = cv2.imread(image_path)
    if img is None:
        raise FileNotFoundError(f"Could not read image: {image_path}")

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    _, bright = cv2.threshold(gray, 140, 255, cv2.THRESH_BINARY)

    contours, _ = cv2.findContours(bright, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        raise RuntimeError("Could not detect the maze board.")

    contours = sorted(contours, key=cv2.contourArea, reverse=True)
    x, y, w, h = cv2.boundingRect(contours[0])

    padding = 20
    x1 = max(0, x - padding)
    y1 = max(0, y - padding)
    x2 = min(img.shape[1], x + w + padding)
    y2 = min(img.shape[0], y + h + padding)

    crop = img[y1:y2, x1:x2]
    return crop


def detect_corner_markers(crop, debug_prefix=None):
    hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
    found = {}
    for color_name, ranges in CORNER_COLOR_RANGES.items():
        mask = np.zeros(hsv.shape[:2], dtype=np.uint8)
        for lo, hi in ranges:
            mask |= cv2.inRange(hsv, lo, hi)
        kernel = np.ones((5, 5), np.uint8)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
        mask = cv2.dilate(mask, kernel, iterations=1)
        if debug_prefix:
            cv2.imwrite(f"{debug_prefix}_{color_name}_mask.png", mask)
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not contours:
            continue
        largest = max(contours, key=cv2.contourArea)
        if cv2.contourArea(largest) < 50:
            continue
        M = cv2.moments(largest)
        if M["m00"] == 0:
            continue
        found[color_name] = (M["m10"] / M["m00"], M["m01"] / M["m00"])
    return found


def log_corner_orientation(crop):
    markers = detect_corner_markers(crop)
    if len(markers) < 4:
        missing = set(CORNER_COLOR_RANGES.keys()) - set(markers.keys())
        print(f"[corners] Only found {len(markers)}/4 corner markers "
              f"(missing: {sorted(missing)}). Tune CORNER_COLOR_RANGES if needed.")
        return markers

    pts = np.array(list(markers.values()))
    names = list(markers.keys())
    s = pts.sum(axis=1)
    diff = pts[:, 0] - pts[:, 1]
    orientation = {
        "top-left": names[np.argmin(s)],
        "top-right": names[np.argmax(diff)],
        "bottom-right": names[np.argmax(s)],
        "bottom-left": names[np.argmin(diff)],
    }
    print("[corners] Orientation:", orientation)
    return markers


def detect_grid_homography(crop, ncells=GRID_CELLS, cell_px=CELL, pad_px=PAD):
    b, g, r = cv2.split(crop.astype(int))
    teal_mask = ((b > 110) & (g > 110) & (r < g - 15) & (r < b - 15)).astype(np.uint8) * 255
    kernel = np.ones((5, 5), np.uint8)
    teal_mask = cv2.dilate(teal_mask, kernel, iterations=1)

    n, labels, stats, centroids = cv2.connectedComponentsWithStats(teal_mask)
    pts = centroids[1:]
    areas = stats[1:, cv2.CC_STAT_AREA]
    pts = pts[areas > 150]

    if len(pts) < 12:
        raise RuntimeError("Not enough teal/cyan posts detected to align grid.")

    h, w = crop.shape[:2]
    margin_guess = 110
    x0, y0 = margin_guess, margin_guess
    dx = (w - 2 * margin_guess) / ncells
    dy = (h - 2 * margin_guess) / ncells

    for _ in range(8):
        col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
        row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
        A_x = np.vstack([col_idx, np.ones(len(col_idx))]).T
        dx, x0 = np.linalg.lstsq(A_x, pts[:, 0], rcond=None)[0]
        A_y = np.vstack([row_idx, np.ones(len(row_idx))]).T
        dy, y0 = np.linalg.lstsq(A_y, pts[:, 1], rcond=None)[0]

    for thresh in (40, 25, 15):
        col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
        row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
        resid = np.sqrt((pts[:, 0] - (x0 + dx * col_idx)) ** 2 +
                         (pts[:, 1] - (y0 + dy * row_idx)) ** 2)
        pts = pts[resid < thresh]
        for _ in range(5):
            col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
            row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
            A_x = np.vstack([col_idx, np.ones(len(col_idx))]).T
            dx, x0 = np.linalg.lstsq(A_x, pts[:, 0], rcond=None)[0]
            A_y = np.vstack([row_idx, np.ones(len(row_idx))]).T
            dy, y0 = np.linalg.lstsq(A_y, pts[:, 1], rcond=None)[0]

    col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
    row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
    col_idx = np.clip(col_idx, 0, ncells)
    row_idx = np.clip(row_idx, 0, ncells)

    src = pts.astype(np.float32)
    dst = np.stack([col_idx * cell_px + pad_px, row_idx * cell_px + pad_px], axis=1).astype(np.float32)
    H, inlier_mask = cv2.findHomography(src, dst, cv2.RANSAC, 8.0)
    if H is None:
        raise RuntimeError("Homography fit failed -- check cyan post detection.")

    proj = cv2.perspectiveTransform(src.reshape(-1, 1, 2), H).reshape(-1, 2)
    err = np.linalg.norm(proj - dst, axis=1)
    print(f"[grid] homography fit: {int(inlier_mask.sum())}/{len(src)} inliers, "
          f"mean reprojection error {err.mean():.1f}px, max {err.max():.1f}px")

    canvas_size = ncells * cell_px + 2 * pad_px
    warped = cv2.warpPerspective(crop, H, (canvas_size, canvas_size))

    N = ncells + 1
    return warped, H, N


def node(i, j, cell_px=CELL, pad_px=PAD):
    return (pad_px + i * cell_px, pad_px + j * cell_px)


def is_wall(gray, p1, p2, obstacle_mask=None, sobel_mag=None,
            inner_win=13, outer_lo=20, outer_hi=30, drop=35,
            thick_frac=0.55, thick_min_run=8,
            thin_frac=0.80, thin_min_run=2,
            grad_thresh=25, grad_frac=0.60):
    x1, y1 = p1
    x2, y2 = p2
    length = np.hypot(x2 - x1, y2 - y1)
    if length == 0:
        return False
    ux, uy = (x2 - x1) / length, (y2 - y1) / length
    px, py = -uy, ux
    thick_hits = thin_hits = grad_hits = total = 0

    def sample(img, x, y, off):
        xi, yi = int(round(x + px * off)), int(round(y + py * off))
        if 0 <= yi < img.shape[0] and 0 <= xi < img.shape[1]:
            if obstacle_mask is not None and obstacle_mask[yi, xi]:
                return None
            return float(img[yi, xi])
        return None

    for t in np.linspace(0.15, 0.85, 25):
        x, y = x1 + (x2 - x1) * t, y1 + (y2 - y1) * t

        outer_vals = []
        for off in list(range(-outer_hi, -outer_lo)) + list(range(outer_lo, outer_hi)):
            v = sample(gray, x, y, off)
            if v is not None:
                outer_vals.append(v)
        if not outer_vals:
            continue
        baseline = np.median(outer_vals)

        inner_vals = [sample(gray, x, y, off) for off in range(-inner_win, inner_win + 1)]
        total += 1

        run = max_run = 0
        for v in inner_vals:
            if v is not None and abs(v - baseline) > drop:
                run += 1
                max_run = max(max_run, run)
            else:
                run = 0
        if max_run >= thick_min_run:
            thick_hits += 1
        if max_run >= thin_min_run:
            thin_hits += 1

        if sobel_mag is not None:
            grad_vals = [sample(sobel_mag, x, y, off) for off in range(-inner_win, inner_win + 1)]
            grad_vals = [v for v in grad_vals if v is not None]
            if grad_vals and max(grad_vals) > grad_thresh:
                grad_hits += 1

    if total == 0:
        return False
    return ((thick_hits / total >= thick_frac) or
            (thin_hits / total >= thin_frac) or
            (sobel_mag is not None and grad_hits / total >= grad_frac))


def compute_sobel_magnitude(gray):
    blurred = cv2.GaussianBlur(gray, (3, 3), 0)
    gx = cv2.Sobel(blurred, cv2.CV_32F, 1, 0, ksize=3)
    gy = cv2.Sobel(blurred, cv2.CV_32F, 0, 1, ksize=3)
    return cv2.magnitude(gx, gy)


def detect_obstacle_mask_and_circles(gray, cell_px=CELL):
    _, dark_mask = cv2.threshold(cv2.medianBlur(gray, 5), 90, 255, cv2.THRESH_BINARY_INV)
    contours, _ = cv2.findContours(dark_mask, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

    obstacle_mask = np.zeros(gray.shape, dtype=np.uint8)
    circles = []
    min_area = (cell_px * 0.2) ** 2 * np.pi
    max_area = (cell_px * 0.6) ** 2 * np.pi

    for cnt in contours:
        area = cv2.contourArea(cnt)
        if min_area < area < max_area:
            perimeter = cv2.arcLength(cnt, True)
            if perimeter > 0:
                circularity = 4 * np.pi * area / (perimeter * perimeter)
                if circularity > 0.60:
                    (x, y), radius = cv2.minEnclosingCircle(cnt)
                    circles.append((x, y, radius))
                    cv2.circle(obstacle_mask, (int(x), int(y)), int(radius + 6), 1, -1)

    return obstacle_mask.astype(bool), circles


def cell_for_point(x, y, ncells, cell_px=CELL, pad_px=PAD):
    col = int(round((x - pad_px) / cell_px - 0.5))
    row = int(round((y - pad_px) / cell_px - 0.5))
    col = min(max(col, 0), ncells - 1)
    row = min(max(row, 0), ncells - 1)
    return row, col


def detect_walls_and_obstacles(warped, ncells, cell_px=CELL, pad_px=PAD):
    gray = cv2.cvtColor(warped, cv2.COLOR_BGR2GRAY)
    obstacle_mask, circles = detect_obstacle_mask_and_circles(gray, cell_px)
    sobel_mag = compute_sobel_magnitude(gray)

    N = ncells + 1
    h_edges, v_edges = {}, {}
    for j in range(N):
        for i in range(N - 1):
            h_edges[(i, j)] = is_wall(gray, node(i, j, cell_px, pad_px),
                                       node(i + 1, j, cell_px, pad_px),
                                       obstacle_mask, sobel_mag)
    for j in range(N - 1):
        for i in range(N):
            v_edges[(i, j)] = is_wall(gray, node(i, j, cell_px, pad_px),
                                       node(i, j + 1, cell_px, pad_px),
                                       obstacle_mask, sobel_mag)

    blocked_cells = set()
    for x, y, r in circles:
        blocked_cells.add(cell_for_point(x, y, ncells, cell_px, pad_px))

    return h_edges, v_edges, blocked_cells, circles


def apply_wall_overrides(h_edges, v_edges, overrides, ncells):
    # Translate each (cell, direction) override into the underlying
    # h_edges/v_edges key and stamp the requested value directly onto it.
    # This is the ONLY place overrides take effect -- everything downstream
    # (BFS, clearance checks, waypoint generation) just sees updated edges,
    # so an opened wall is treated exactly like a real detected opening.
    applied = []
    for (r, c), d in list(overrides.keys()):
        val = overrides[((r, c), d)]
        if d == "N":
            if r == 0:
                continue
            key, table = (c, r), h_edges
        elif d == "S":
            if r == ncells - 1:
                continue
            key, table = (c, r + 1), h_edges
        elif d == "E":
            if c == ncells - 1:
                continue
            key, table = (c + 1, r), v_edges
        elif d == "W":
            if c == 0:
                continue
            key, table = (c, r), v_edges
        else:
            continue
        old = table.get(key)
        table[key] = val
        applied.append(((r, c), d, old, val))
    return applied


def blocked(h_edges, v_edges, blocked_cells, r, c, direction, ncells, avoid_obstacles=False):
    if avoid_obstacles and (r, c) in blocked_cells:
        return True
    if direction == "N":
        if r == 0:
            return True
        return h_edges.get((c, r), True)
    if direction == "S":
        if r == ncells - 1:
            return True
        return h_edges.get((c, r + 1), True)
    if direction == "E":
        if c == ncells - 1:
            return True
        return v_edges.get((c + 1, r), True)
    if direction == "W":
        if c == 0:
            return True
        return v_edges.get((c, r), True)
    raise ValueError(direction)

DIRS = {"N": (-1, 0), "S": (1, 0), "E": (0, 1), "W": (0, -1)}

def bfs(h_edges, v_edges, blocked_cells, start, goal, ncells, avoid_obstacles=False):
    from collections import deque

    queue = deque([start])
    came_from = {start: None}

    while queue:
        cur = queue.popleft()

        if cur == goal:
            path = [goal]
            while path[-1] != start:
                path.append(came_from[path[-1]])
            path.reverse()
            return path

        r, c = cur
        for d, (dr, dc) in DIRS.items():
            if blocked(h_edges, v_edges, blocked_cells, r, c, d, ncells, avoid_obstacles):
                continue
            nxt = (r + dr, c + dc)
            if avoid_obstacles and nxt in blocked_cells:
                continue
            if nxt not in came_from:
                came_from[nxt] = cur
                queue.append(nxt)

    return None


def reachable_cells(h_edges, v_edges, blocked_cells, start, ncells, avoid_obstacles=False):
    from collections import deque
    seen = {start}
    q = deque([start])
    while q:
        r, c = q.popleft()
        for d, (dr, dc) in DIRS.items():
            if blocked(h_edges, v_edges, blocked_cells, r, c, d, ncells, avoid_obstacles):
                continue
            nxt = (r + dr, c + dc)
            if avoid_obstacles and nxt in blocked_cells:
                continue
            if nxt not in seen:
                seen.add(nxt)
                q.append(nxt)
    return seen


def find_seal(h_edges, v_edges, blocked_cells, start, goal, ncells):
    # If start can't reach goal, find the boundary of GOAL's own sealed
    # region, then test each candidate edge by actually re-running BFS with
    # only that one edge opened. This distinguishes edges that reconnect
    # all the way to `start` from edges that only open into some other
    # small isolated pocket (which happens on boards with more than one
    # sealed-off area) -- so what gets reported is verified to work alone,
    # not just "borders a different cell".
    reach_goal = reachable_cells(h_edges, v_edges, blocked_cells, goal, ncells)
    if start in reach_goal:
        return None
    boundary = []
    for (r, c) in reach_goal:
        for d, (dr, dc) in DIRS.items():
            nr, nc = r + dr, c + dc
            if 0 <= nr < ncells and 0 <= nc < ncells and (nr, nc) not in reach_goal:
                boundary.append(((r, c), d, (nr, nc)))

    verified = []
    for (r, c), d, nxt in boundary:
        h2, v2 = dict(h_edges), dict(v_edges)
        apply_wall_overrides(h2, v2, {((r, c), d): False}, ncells)
        if bfs(h2, v2, blocked_cells, start, goal, ncells) is not None:
            verified.append(((r, c), d, nxt))
    return verified


def find_effective_start(h_edges, v_edges, blocked_cells, desired_start, goal, ncells):
    reach_goal = reachable_cells(h_edges, v_edges, blocked_cells, goal, ncells)
    if desired_start in reach_goal:
        return desired_start, False, 0.0

    best, best_d2 = None, float('inf')
    for cell in reach_goal:
        d2 = (cell[0] - desired_start[0]) ** 2 + (cell[1] - desired_start[1]) ** 2
        if d2 < best_d2:
            best, best_d2 = cell, d2
    return best, True, best_d2 ** 0.5


TURN_ORDER = ["N", "E", "S", "W"]

def path_to_commands(path, start_heading):
    commands = []
    heading = start_heading
    for a, b in zip(path, path[1:]):
        dr, dc = b[0] - a[0], b[1] - a[1]
        want = [d for d, v in DIRS.items() if v == (dr, dc)][0]
        cur_i = TURN_ORDER.index(heading)
        want_i = TURN_ORDER.index(want)
        diff = (want_i - cur_i) % 4
        if diff == 1:
            commands.append("R")
        elif diff == 3:
            commands.append("L")
        elif diff == 2:
            commands += ["R", "R"]
        commands.append("F")
        heading = want
    return commands, heading

def turn_to_heading(commands, current_heading, desired_heading):
    cur_i = TURN_ORDER.index(current_heading)
    want_i = TURN_ORDER.index(desired_heading)
    diff = (want_i - cur_i) % 4
    if diff == 1:
        commands.append("R")
    elif diff == 3:
        commands.append("L")
    elif diff == 2:
        commands += ["R", "R"]
    return commands, desired_heading


def wall_segments(h_edges, v_edges, cell_px=CELL, pad_px=PAD):
    segs = []
    for (i, j), is_w in h_edges.items():
        if is_w:
            segs.append((node(i, j, cell_px, pad_px), node(i + 1, j, cell_px, pad_px)))
    for (i, j), is_w in v_edges.items():
        if is_w:
            segs.append((node(i, j, cell_px, pad_px), node(i, j + 1, cell_px, pad_px)))
    return segs


def _seg_intersect(p1, p2, p3, p4):
    def ccw(a, b, c):
        return (c[1] - a[1]) * (b[0] - a[0]) - (b[1] - a[1]) * (c[0] - a[0])
    d1, d2 = ccw(p3, p4, p1), ccw(p3, p4, p2)
    d3, d4 = ccw(p1, p2, p3), ccw(p1, p2, p4)
    if ((d1 > 0 and d2 < 0) or (d1 < 0 and d2 > 0)) and \
       ((d3 > 0 and d4 < 0) or (d3 < 0 and d4 > 0)):
        return True
    return False


def _seg_point_dist(p1, p2, pt):
    x1, y1 = p1
    x2, y2 = p2
    px, py = pt
    dx, dy = x2 - x1, y2 - y1
    if dx == 0 and dy == 0:
        return float(np.hypot(px - x1, py - y1))
    t = max(0.0, min(1.0, ((px - x1) * dx + (py - y1) * dy) / (dx * dx + dy * dy)))
    return float(np.hypot(px - (x1 + t * dx), py - (y1 + t * dy)))


def _seg_seg_dist(p1, p2, p3, p4):
    if _seg_intersect(p1, p2, p3, p4):
        return 0.0
    return min(
        _seg_point_dist(p1, p2, p3),
        _seg_point_dist(p1, p2, p4),
        _seg_point_dist(p3, p4, p1),
        _seg_point_dist(p3, p4, p2),
    )


def has_line_of_sight(p1, p2, wall_segs, circles, wall_margin=CLEARANCE_PX, obs_margin=CLEARANCE_PX):
    for w1, w2 in wall_segs:
        if _seg_seg_dist(p1, p2, w1, w2) < wall_margin:
            return False
    for cx, cy, r in circles:
        if _seg_point_dist(p1, p2, (cx, cy)) < r + obs_margin:
            return False
    return True


def min_wall_clearance_px(path, wall_segs, circles):
    best = float('inf')
    for p1, p2 in zip(path, path[1:]):
        for w1, w2 in wall_segs:
            best = min(best, _seg_seg_dist(p1, p2, w1, w2))
        for cx, cy, r in circles:
            best = min(best, _seg_point_dist(p1, p2, (cx, cy)) - r)
    return best


def pixel_path_to_mm(pixel_path, cell_px=CELL, pad_px=PAD, cell_mm=180.0, flip_xy=True):
    pts_mm = [((x - pad_px) / cell_px * cell_mm, (y - pad_px) / cell_px * cell_mm)
              for x, y in pixel_path]
    if flip_xy:
        pts_mm = [(y, x) for x, y in pts_mm]
    return pts_mm


def format_waypoints_c_array(waypoints):
    lines = []
    for i, (a, b) in enumerate(waypoints):
        a_str = f"{a:g}"
        b_str = f"{b:g}"
        comma = "," if i < len(waypoints) - 1 else ""
        lines.append(f"    {{{a_str}, {b_str}}}{comma}")
    return "\n".join(lines)


def cell_path_to_axis_waypoints(grid_path, cell_px=CELL, pad_px=PAD):
    if not grid_path:
        return []
    pts = [node(c + 0.5, r + 0.5, cell_px, pad_px) for r, c in grid_path]
    if len(pts) == 1:
        return pts

    waypoints = [pts[0]]
    for i in range(1, len(pts) - 1):
        prev_pt, cur_pt, next_pt = pts[i - 1], pts[i], pts[i + 1]
        dir1 = (round(cur_pt[0] - prev_pt[0], 3), round(cur_pt[1] - prev_pt[1], 3))
        dir2 = (round(next_pt[0] - cur_pt[0], 3), round(next_pt[1] - cur_pt[1], 3))
        if dir1 != dir2:
            waypoints.append(cur_pt)
    waypoints.append(pts[-1])
    return waypoints


def path_length_px(pixel_path):
    return sum(np.hypot(pixel_path[i+1][0]-pixel_path[i][0], pixel_path[i+1][1]-pixel_path[i][1])
               for i in range(len(pixel_path)-1))


def save_overlay(warped, ncells, h_edges, v_edges, grid_path, free_path, circles, out_path,
                  requested_start=None, effective_start=None,
                  cell_px=CELL, pad_px=PAD):
    overlay = warped.copy()

    def nd(i, j):
        p = node(i, j, cell_px, pad_px)
        return (int(p[0]), int(p[1]))

    for (i, j), val in h_edges.items():
        if val:
            cv2.line(overlay, nd(i, j), nd(i + 1, j), (0, 0, 255), 3)
    for (i, j), val in v_edges.items():
        if val:
            cv2.line(overlay, nd(i, j), nd(i, j + 1), (0, 255, 0), 3)

    if circles:
        for x, y, r in circles:
            cv2.circle(overlay, (int(x), int(y)), int(r), (0, 0, 255), -1)
            cv2.putText(overlay, "OBS", (int(x)-15, int(y)+5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 2)

    if grid_path:
        pts_line = [nd(c + 0.5, r + 0.5) for r, c in grid_path]
        for i in range(len(pts_line) - 1):
            cv2.line(overlay, pts_line[i], pts_line[i+1], (180, 180, 180), 2)

    if free_path:
        pts = [(int(x), int(y)) for x, y in free_path]
        for i in range(len(pts) - 1):
            cv2.line(overlay, pts[i], pts[i+1], (255, 0, 255), 4)
        cv2.circle(overlay, pts[0], 10, (0, 200, 0), -1)
        cv2.circle(overlay, pts[-1], 10, (0, 0, 200), -1)

    if requested_start is not None and requested_start != effective_start:
        rr, rc = requested_start
        cv2.circle(overlay, nd(rc + 0.5, rr + 0.5), 9, (255, 255, 255), 2)
        cv2.putText(overlay, "requested (sealed)", (nd(rc + 0.5, rr + 0.5)[0] - 60, nd(rc + 0.5, rr + 0.5)[1] - 15),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255, 255, 255), 1)

    cv2.imwrite(out_path, overlay)

def main():
    crop = load_and_crop(IMAGE_PATH)

    log_corner_orientation(crop)

    warped, H, N = detect_grid_homography(crop, ncells=GRID_CELLS)
    ncells = N - 1
    print(f"Detected grid: {N}x{N} nodes -> {ncells}x{ncells} cells")

    input_path = f"{OUTPUT_PREFIX}_input.png"
    cv2.imwrite(input_path, warped)

    h_edges, v_edges, blocked_cells, circles = detect_walls_and_obstacles(warped, ncells)

    if WALL_OVERRIDES:
        applied = apply_wall_overrides(h_edges, v_edges, WALL_OVERRIDES, ncells)
        for (r, c), d, old, new in applied:
            print(f"[override] cell {(r,c)} side {d}: wall={old} -> wall={new} "
                  f"(make sure this matches what's physically on the board!)")

    print(f"\n[clearance] robot length {ROBOT_LENGTH_MM:.0f}mm, cell size {CELL_MM:.0f}mm -> "
          f"keeping the path at least {CLEARANCE_PX:.1f}px (~{CLEARANCE_PX*MM_PER_PX:.1f}mm) "
          f"from every wall/obstacle edge, including at turns. That leaves the robot's physical "
          f"edge ~{CLEARANCE_PX*MM_PER_PX - ROBOT_LENGTH_MM/2:.1f}mm clear of every wall.")

    if bfs(h_edges, v_edges, blocked_cells, START_CELL, GOAL_CELL, ncells) is None:
        seal = find_seal(h_edges, v_edges, blocked_cells, START_CELL, GOAL_CELL, ncells)
        print(f"\n[SEALED] No wall-legal route exists from {START_CELL} to {GOAL_CELL} on this "
              f"board as detected. These are the {len(seal)} wall edges forming the closed "
              f"boundary between them -- opening ANY ONE of them (both in reality and in "
              f"WALL_OVERRIDES above) would connect the two regions:")
        for (r, c), d, nxt in seal:
            print(f"    ((({r}, {c}), \"{d}\")): False,   # opens edge to {nxt}")
        print("\nNot proceeding with a fabricated path -- add a real/confirmed opening to "
              "WALL_OVERRIDES above (and physically open it on the board before driving the "
              "robot), then re-run.")

        overlay_path = f"{OUTPUT_PREFIX}_overlay.png"
        save_overlay(warped, ncells, h_edges, v_edges, None, None, circles, overlay_path,
                     requested_start=START_CELL, effective_start=None)
        combined_path = f"{OUTPUT_PREFIX}_input_vs_output.png"
        out_img = cv2.imread(overlay_path)
        combined = cv2.hconcat([warped, out_img])
        cv2.imwrite(combined_path, combined)
        return

    effective_start, snapped, snap_dist = find_effective_start(
        h_edges, v_edges, blocked_cells, START_CELL, GOAL_CELL, ncells)

    grid_path = bfs(h_edges, v_edges, blocked_cells, effective_start, GOAL_CELL, ncells)

    segs = wall_segments(h_edges, v_edges)
    free_path = cell_path_to_axis_waypoints(grid_path)

    def path_clears(path):
        return all(has_line_of_sight(p1, p2, segs, circles) for p1, p2 in zip(path, path[1:]))

    if not path_clears(free_path):
        print("[warn] the straight/orthogonal route couldn't certify "
              f"{CLEARANCE_PX:.1f}px (~{CLEARANCE_PX*MM_PER_PX:.1f}mm) of clearance from a wall or "
              "obstacle along the way. Trying a STRICT obstacle-avoiding grid path instead "
              "(one that never enters a cell containing an obstacle at all).")
        safe_grid_path = bfs(h_edges, v_edges, blocked_cells, effective_start, GOAL_CELL, ncells,
                              avoid_obstacles=True)
        if safe_grid_path is None:
            obstacle_cells_on_path = [c for c in grid_path if c in blocked_cells]
            print(f"\n[UNSAFE] No route exists from {effective_start} to {GOAL_CELL} that "
                  f"avoids every obstacle cell entirely.")
        else:
            print("[ok] found a strict obstacle-avoiding grid route.")
            grid_path = safe_grid_path
            free_path = cell_path_to_axis_waypoints(grid_path)
    else:
        print(f"\n[ok] straight/orthogonal route through {len(grid_path)} cells keeps "
              f"{CLEARANCE_PX:.1f}px (~{CLEARANCE_PX*MM_PER_PX:.1f}mm) clearance the whole way -- "
              f"only left/right turns, no diagonals.")

    measured_centerline_to_wall_px = min_wall_clearance_px(free_path, segs, circles)
    measured_centerline_to_wall_mm = measured_centerline_to_wall_px * MM_PER_PX
    robot_edge_gap_mm = measured_centerline_to_wall_mm - ROBOT_LENGTH_MM / 2.0
    if measured_centerline_to_wall_px < CLEARANCE_PX - 1e-6:
        print(f"\n[UNSAFE] Measured centerline-to-wall distance is only "
              f"{measured_centerline_to_wall_mm:.1f}mm, which leaves just {robot_edge_gap_mm:.1f}mm "
              f"of physical clearance for a {ROBOT_LENGTH_MM:.0f}mm-wide robot -- below the "
              f"{SAFETY_BUFFER_PX*MM_PER_PX:.1f}mm safety buffer. Do not send this path to the robot.")
    else:
        print(f"\n[verified] Robot ({ROBOT_LENGTH_MM:.0f}mm) stays centered between walls -- "
              f"measured {robot_edge_gap_mm:.1f}mm of physical clearance between the robot's "
              f"edge and the nearest wall. No collisions.")

    grid_len_cells = len(grid_path) - 1
    free_len_px = path_length_px(free_path)
    free_len_cells_equiv = free_len_px / CELL
    print(f"\nGrid-constrained path: {grid_len_cells} cell-moves")
    print(f"Orthogonal (L/R-turn-only) path: {free_len_px:.1f}px "
          f"(~{free_len_cells_equiv:.2f} cell-widths) through {len(free_path)} waypoints "
          f"(turn points only)")

    overlay_path = f"{OUTPUT_PREFIX}_overlay.png"
    save_overlay(warped, ncells, h_edges, v_edges, grid_path, free_path, circles, overlay_path,
                 requested_start=START_CELL, effective_start=effective_start)

    combined_path = f"{OUTPUT_PREFIX}_input_vs_output.png"
    out_img = cv2.imread(overlay_path)
    combined = cv2.hconcat([warped, out_img])
    cv2.imwrite(combined_path, combined)

    print("\nOrthogonal path, turn points only (pixel coords on warped image):")
    for x, y in free_path:
        print(f"  ({x:.1f}, {y:.1f})")

    waypoints_mm = pixel_path_to_mm(free_path, cell_mm=CELL_MM, flip_xy=True)
    print(f"\nWaypoints (mm, {int(CELL_MM)}mm/cell, axes flipped, turn-points only, "
          f"straight segments between them -- no diagonals):")
    print("{")
    print(format_waypoints_c_array(waypoints_mm))
    print("}")

    waypoints_txt_path = f"{OUTPUT_PREFIX}_waypoints_mm.txt"
    with open(waypoints_txt_path, "w") as f:
        f.write("{\n")
        f.write(format_waypoints_c_array(waypoints_mm))
        f.write("\n}\n")

    commands, final_heading = path_to_commands(grid_path, START_HEADING)
    commands, final_heading = turn_to_heading(commands, final_heading, END_HEADING)
    print("\nTurn/forward commands:", "".join(commands))

    result_path = f"{OUTPUT_PREFIX}_result.json"
    json.dump({
        "grid_cells": ncells,
        "requested_start": START_CELL,
        "effective_start": effective_start,
        "start_was_snapped": snapped,
        "snap_distance_cells": snap_dist,
        "goal": GOAL_CELL,
        "grid_path": grid_path,
        "commands": "".join(commands),
        "free_path_px": free_path,
        "free_path_length_px": free_len_px,
        "waypoints_mm": waypoints_mm,
    }, open(result_path, "w"), indent=2)

    open_image(combined_path)

if __name__ == "__main__":
    main()