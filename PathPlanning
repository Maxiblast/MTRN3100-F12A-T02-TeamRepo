def open_image(path):
    path = os.path.abspath(path)
    try:
        if sys.platform.startswith("win"):
            os.startfile(path)
        elif sys.platform == "darwin":
            subprocess.run(["open", path], check=False)
        else:
            subprocess.run(["xdg-open", path], check=False)
    except Exception as e:
        print(f"(Could not auto-open {path}: {e}. Open it manually.)")

IMAGE_PATH   = "newmaze.jpg"
START_CELL   = (7, 5)
GOAL_CELL    = (2, 1)
START_HEADING = "N"
END_HEADING   = "E"
OUTPUT_PREFIX = "maze_run"
GRID_CELLS    = 9

CELL = 100
PAD  = 150

CORNER_COLOR_RANGES = {
    "pink":   [(np.array([160, 25, 90]),  np.array([180, 255, 255])),
               (np.array([0,   25, 90]),  np.array([8,   255, 255]))],
    "orange": [(np.array([5,   120, 55]), np.array([18,  255, 255]))],
    "purple": [(np.array([100, 60, 60]),  np.array([130, 255, 255]))],
    "yellow": [(np.array([18,  120, 30]), np.array([32,  255, 255]))],
}


def load_and_crop(image_path):
    img = cv2.imread(image_path)
    if img is None:
        raise FileNotFoundError(f"Could not read image: {image_path}")

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    _, bright = cv2.threshold(gray, 140, 255, cv2.THRESH_BINARY)

    contours, _ = cv2.findContours(bright, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        raise RuntimeError("Could not detect the maze board.")

    contours = sorted(contours, key=cv2.contourArea, reverse=True)
    x, y, w, h = cv2.boundingRect(contours[0])

    padding = 20
    x1 = max(0, x - padding)
    y1 = max(0, y - padding)
    x2 = min(img.shape[1], x + w + padding)
    y2 = min(img.shape[0], y + h + padding)

    crop = img[y1:y2, x1:x2]
    return crop


def detect_corner_markers(crop, debug_prefix=None):
    hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
    found = {}
    for color_name, ranges in CORNER_COLOR_RANGES.items():
        mask = np.zeros(hsv.shape[:2], dtype=np.uint8)
        for lo, hi in ranges:
            mask |= cv2.inRange(hsv, lo, hi)
        kernel = np.ones((5, 5), np.uint8)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
        mask = cv2.dilate(mask, kernel, iterations=1)
        if debug_prefix:
            cv2.imwrite(f"{debug_prefix}_{color_name}_mask.png", mask)
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not contours:
            continue
        largest = max(contours, key=cv2.contourArea)
        if cv2.contourArea(largest) < 50:
            continue
        M = cv2.moments(largest)
        if M["m00"] == 0:
            continue
        found[color_name] = (M["m10"] / M["m00"], M["m01"] / M["m00"])
    return found


def log_corner_orientation(crop):
    markers = detect_corner_markers(crop)
    if len(markers) < 4:
        missing = set(CORNER_COLOR_RANGES.keys()) - set(markers.keys())
        print(f"[corners] Only found {len(markers)}/4 corner markers "
              f"(missing: {sorted(missing)}). Tune CORNER_COLOR_RANGES if needed.")
        return markers

    pts = np.array(list(markers.values()))
    names = list(markers.keys())
    s = pts.sum(axis=1)
    diff = pts[:, 0] - pts[:, 1]
    orientation = {
        "top-left": names[np.argmin(s)],
        "top-right": names[np.argmax(diff)],
        "bottom-right": names[np.argmax(s)],
        "bottom-left": names[np.argmin(diff)],
    }
    print("[corners] Orientation:", orientation)
    return markers


def detect_grid_homography(crop, ncells=GRID_CELLS, cell_px=CELL, pad_px=PAD):
    b, g, r = cv2.split(crop.astype(int))
    teal_mask = ((b > 110) & (g > 110) & (r < g - 15) & (r < b - 15)).astype(np.uint8) * 255
    kernel = np.ones((5, 5), np.uint8)
    teal_mask = cv2.dilate(teal_mask, kernel, iterations=1)

    n, labels, stats, centroids = cv2.connectedComponentsWithStats(teal_mask)
    pts = centroids[1:]
    areas = stats[1:, cv2.CC_STAT_AREA]
    pts = pts[areas > 150]

    if len(pts) < 12:
        raise RuntimeError("Not enough teal/cyan posts detected to align grid.")

    h, w = crop.shape[:2]
    margin_guess = 110
    x0, y0 = margin_guess, margin_guess
    dx = (w - 2 * margin_guess) / ncells
    dy = (h - 2 * margin_guess) / ncells

    for _ in range(8):
        col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
        row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
        A_x = np.vstack([col_idx, np.ones(len(col_idx))]).T
        dx, x0 = np.linalg.lstsq(A_x, pts[:, 0], rcond=None)[0]
        A_y = np.vstack([row_idx, np.ones(len(row_idx))]).T
        dy, y0 = np.linalg.lstsq(A_y, pts[:, 1], rcond=None)[0]

    for thresh in (40, 25, 15):
        col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
        row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
        resid = np.sqrt((pts[:, 0] - (x0 + dx * col_idx)) ** 2 +
                         (pts[:, 1] - (y0 + dy * row_idx)) ** 2)
        pts = pts[resid < thresh]
        for _ in range(5):
            col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
            row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
            A_x = np.vstack([col_idx, np.ones(len(col_idx))]).T
            dx, x0 = np.linalg.lstsq(A_x, pts[:, 0], rcond=None)[0]
            A_y = np.vstack([row_idx, np.ones(len(row_idx))]).T
            dy, y0 = np.linalg.lstsq(A_y, pts[:, 1], rcond=None)[0]

    col_idx = np.round((pts[:, 0] - x0) / dx).astype(int)
    row_idx = np.round((pts[:, 1] - y0) / dy).astype(int)
    col_idx = np.clip(col_idx, 0, ncells)
    row_idx = np.clip(row_idx, 0, ncells)

    src = pts.astype(np.float32)
    dst = np.stack([col_idx * cell_px + pad_px, row_idx * cell_px + pad_px], axis=1).astype(np.float32)
    H, inlier_mask = cv2.findHomography(src, dst, cv2.RANSAC, 8.0)
    if H is None:
        raise RuntimeError("Homography fit failed -- check cyan post detection.")

    proj = cv2.perspectiveTransform(src.reshape(-1, 1, 2), H).reshape(-1, 2)
    err = np.linalg.norm(proj - dst, axis=1)
    print(f"[grid] homography fit: {int(inlier_mask.sum())}/{len(src)} inliers, "
          f"mean reprojection error {err.mean():.1f}px, max {err.max():.1f}px")

    canvas_size = ncells * cell_px + 2 * pad_px
    warped = cv2.warpPerspective(crop, H, (canvas_size, canvas_size))

    N = ncells + 1
    return warped, H, N


def node(i, j, cell_px=CELL, pad_px=PAD):
    return (pad_px + i * cell_px, pad_px + j * cell_px)


# ---------------------------------------------------------------------------
# Wall detection.
#
# Fix history:
#   1. Baseline sampled from a band clearly OUTSIDE the wall's real width.
#   2. Requires a CONTIGUOUS deviating run (thick aluminum) OR a
#      near-continuous faint run the full length (thin acrylic/rod).
#   3. obstacle_mask excludes pixels belonging to a round obstacle pylon.
#   4. Deviation checked as ABSOLUTE (abs(v-baseline) > drop) so both
#      shadowed-dark walls AND reflective/bright walls are caught.
#   5. NEW -- gradient fallback: a same-brightness-as-floor rod is invisible
#      to ANY brightness threshold, in either direction, because its
#      deviation is smaller than `drop` no matter which way you check. But
#      it still has a physical edge on each side, which shows up as a
#      local intensity GRADIENT (Sobel) even when raw brightness barely
#      moves. This adds gradient magnitude as a third, independent trigger,
#      OR'd with the two brightness-based checks -- so a wall counts if
#      brightness deviates enough, OR if there's a strong consistent
#      gradient along the line, regardless of brightness.
# ---------------------------------------------------------------------------
def is_wall(gray, p1, p2, obstacle_mask=None, sobel_mag=None,
            inner_win=13, outer_lo=20, outer_hi=30, drop=35,
            thick_frac=0.55, thick_min_run=8,
            thin_frac=0.80, thin_min_run=2,
            grad_thresh=25, grad_frac=0.60):
    x1, y1 = p1
    x2, y2 = p2
    length = np.hypot(x2 - x1, y2 - y1)
    if length == 0:
        return False
    ux, uy = (x2 - x1) / length, (y2 - y1) / length
    px, py = -uy, ux
    thick_hits = thin_hits = grad_hits = total = 0

    def sample(img, x, y, off):
        xi, yi = int(round(x + px * off)), int(round(y + py * off))
        if 0 <= yi < img.shape[0] and 0 <= xi < img.shape[1]:
            if obstacle_mask is not None and obstacle_mask[yi, xi]:
                return None
            return float(img[yi, xi])
        return None

    for t in np.linspace(0.15, 0.85, 25):
        x, y = x1 + (x2 - x1) * t, y1 + (y2 - y1) * t

        outer_vals = []
        for off in list(range(-outer_hi, -outer_lo)) + list(range(outer_lo, outer_hi)):
            v = sample(gray, x, y, off)
            if v is not None:
                outer_vals.append(v)
        if not outer_vals:
            continue
        baseline = np.median(outer_vals)

        inner_vals = [sample(gray, x, y, off) for off in range(-inner_win, inner_win + 1)]
        total += 1

        run = max_run = 0
        for v in inner_vals:
            if v is not None and abs(v - baseline) > drop:
                run += 1
                max_run = max(max_run, run)
            else:
                run = 0
        if max_run >= thick_min_run:
            thick_hits += 1
        if max_run >= thin_min_run:
            thin_hits += 1

        if sobel_mag is not None:
            grad_vals = [sample(sobel_mag, x, y, off) for off in range(-inner_win, inner_win + 1)]
            grad_vals = [v for v in grad_vals if v is not None]
            if grad_vals and max(grad_vals) > grad_thresh:
                grad_hits += 1

    if total == 0:
        return False
    return ((thick_hits / total >= thick_frac) or
            (thin_hits / total >= thin_frac) or
            (sobel_mag is not None and grad_hits / total >= grad_frac))


def compute_sobel_magnitude(gray):
    """Gradient-magnitude map used as the gradient-based wall fallback in
    is_wall(). Computed once per image and reused for every edge check."""
    blurred = cv2.GaussianBlur(gray, (3, 3), 0)
    gx = cv2.Sobel(blurred, cv2.CV_32F, 1, 0, ksize=3)
    gy = cv2.Sobel(blurred, cv2.CV_32F, 0, 1, ksize=3)
    return cv2.magnitude(gx, gy)


def debug_edge_profile(gray, p1, p2, inner_win=13, outer_lo=20, outer_hi=30):
    """Diagnostic helper -- NOT called by main(). Run this manually on the
    specific missing edge to see the actual raw brightness and gradient
    values, so you can tune drop/grad_thresh against your real footage
    instead of guessing blind.

    Example:
        warped, H, N = detect_grid_homography(crop, ncells=GRID_CELLS)
        gray = cv2.cvtColor(warped, cv2.COLOR_BGR2GRAY)
        debug_edge_profile(gray, node(4, 3), node(5, 3))  # pick i,j of the missing wall
    """
    sobel_mag = compute_sobel_magnitude(gray)
    x1, y1 = p1
    x2, y2 = p2
    length = np.hypot(x2 - x1, y2 - y1)
    ux, uy = (x2 - x1) / length, (y2 - y1) / length
    px, py = -uy, ux

    t = 0.5
    x, y = x1 + (x2 - x1) * t, y1 + (y2 - y1) * t

    print(f"\n[debug] Profile at midpoint of edge {p1} -> {p2}:")
    print(f"{'offset':>7} {'gray':>6} {'grad':>6}")
    for off in range(-outer_hi, outer_hi + 1):
        xi, yi = int(round(x + px * off)), int(round(y + py * off))
        if 0 <= yi < gray.shape[0] and 0 <= xi < gray.shape[1]:
            g = int(gray[yi, xi])
            m = float(sobel_mag[yi, xi])
            flag = " <-- inner window" if abs(off) <= inner_win else ""
            print(f"{off:7d} {g:6d} {m:6.1f}{flag}")

    outer_vals = []
    for off in list(range(-outer_hi, -outer_lo)) + list(range(outer_lo, outer_hi)):
        xi, yi = int(round(x + px * off)), int(round(y + py * off))
        if 0 <= yi < gray.shape[0] and 0 <= xi < gray.shape[1]:
            outer_vals.append(int(gray[yi, xi]))
    if outer_vals:
        baseline = np.median(outer_vals)
        print(f"\nBaseline (outer band median): {baseline:.1f}")

        inner_devs, inner_grads = [], []
        for off in range(-inner_win, inner_win + 1):
            xi, yi = int(round(x + px * off)), int(round(y + py * off))
            if 0 <= yi < gray.shape[0] and 0 <= xi < gray.shape[1]:
                inner_devs.append(abs(int(gray[yi, xi]) - baseline))
                inner_grads.append(float(sobel_mag[yi, xi]))

        if inner_devs:
            print(f"Max |inner - baseline| deviation: {max(inner_devs):.1f}  (current drop threshold: 35)")
        if inner_grads:
            print(f"Max gradient magnitude in inner window: {max(inner_grads):.1f}  (current grad_thresh: 25)")
        print("If both numbers above are small/noisy, the rod may genuinely be indistinguishable")
        print("from the floor in this photo. Options: improve lighting/contrast at capture time,")
        print("lower drop/grad_thresh specifically (watch for false positives elsewhere), or")
        print("hard-code that one edge as a known wall since automated detection may not")
        print("reliably separate it from the floor at this contrast level.")


def detect_obstacle_mask_and_circles(gray, cell_px=CELL):
    _, dark_mask = cv2.threshold(cv2.medianBlur(gray, 5), 90, 255, cv2.THRESH_BINARY_INV)
    contours, _ = cv2.findContours(dark_mask, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

    obstacle_mask = np.zeros(gray.shape, dtype=np.uint8)
    circles = []
    min_area = (cell_px * 0.2) ** 2 * np.pi
    max_area = (cell_px * 0.6) ** 2 * np.pi

    for cnt in contours:
        area = cv2.contourArea(cnt)
        if min_area < area < max_area:
            perimeter = cv2.arcLength(cnt, True)
            if perimeter > 0:
                circularity = 4 * np.pi * area / (perimeter * perimeter)
                if circularity > 0.60:
                    (x, y), radius = cv2.minEnclosingCircle(cnt)
                    circles.append((x, y, radius))
                    cv2.circle(obstacle_mask, (int(x), int(y)), int(radius + 6), 1, -1)

    return obstacle_mask.astype(bool), circles


def cell_for_point(x, y, ncells, cell_px=CELL, pad_px=PAD):
    col = int(round((x - pad_px) / cell_px - 0.5))
    row = int(round((y - pad_px) / cell_px - 0.5))
    col = min(max(col, 0), ncells - 1)
    row = min(max(row, 0), ncells - 1)
    return row, col


def detect_walls_and_obstacles(warped, ncells, cell_px=CELL, pad_px=PAD):
    gray = cv2.cvtColor(warped, cv2.COLOR_BGR2GRAY)
    obstacle_mask, circles = detect_obstacle_mask_and_circles(gray, cell_px)
    sobel_mag = compute_sobel_magnitude(gray)

    N = ncells + 1
    h_edges, v_edges = {}, {}
    for j in range(N):
        for i in range(N - 1):
            h_edges[(i, j)] = is_wall(gray, node(i, j, cell_px, pad_px),
                                       node(i + 1, j, cell_px, pad_px),
                                       obstacle_mask, sobel_mag)
    for j in range(N - 1):
        for i in range(N):
            v_edges[(i, j)] = is_wall(gray, node(i, j, cell_px, pad_px),
                                       node(i, j + 1, cell_px, pad_px),
                                       obstacle_mask, sobel_mag)

    blocked_cells = set()
    for x, y, r in circles:
        blocked_cells.add(cell_for_point(x, y, ncells, cell_px, pad_px))

    return h_edges, v_edges, blocked_cells, circles

def blocked(h_edges, v_edges, blocked_cells, r, c, direction, ncells):
    if (r, c) in blocked_cells:
        return True
    if direction == "N":
        if r == 0:
            return True
        return h_edges.get((c, r), True)
    if direction == "S":
        if r == ncells - 1:
            return True
        return h_edges.get((c, r + 1), True)
    if direction == "E":
        if c == ncells - 1:
            return True
        return v_edges.get((c + 1, r), True)
    if direction == "W":
        if c == 0:
            return True
        return v_edges.get((c, r), True)
    raise ValueError(direction)

DIRS = {"N": (-1, 0), "S": (1, 0), "E": (0, 1), "W": (0, -1)}

def astar(h_edges, v_edges, blocked_cells, start, goal, ncells):
    def heuristic(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    open_set = []
    heapq.heappush(open_set, (0, start))

    came_from = {start: None}
    g_score = {start: 0}

    while open_set:
        _, cur = heapq.heappop(open_set)

        if cur == goal:
            path = [goal]
            while path[-1] != start:
                path.append(came_from[path[-1]])
            path.reverse()
            return path

        r, c = cur
        for d, (dr, dc) in DIRS.items():
            if blocked(h_edges, v_edges, blocked_cells, r, c, d, ncells):
                continue
            nxt = (r + dr, c + dc)
            if nxt in blocked_cells:
                continue
            tentative_g = g_score[cur] + 1

            if tentative_g < g_score.get(nxt, float('inf')):
                came_from[nxt] = cur
                g_score[nxt] = tentative_g
                f_score = tentative_g + heuristic(nxt, goal)
                heapq.heappush(open_set, (f_score, nxt))

    return None

TURN_ORDER = ["N", "E", "S", "W"]

def path_to_commands(path, start_heading):
    commands = []
    heading = start_heading
    for a, b in zip(path, path[1:]):
        dr, dc = b[0] - a[0], b[1] - a[1]
        want = [d for d, v in DIRS.items() if v == (dr, dc)][0]
        cur_i = TURN_ORDER.index(heading)
        want_i = TURN_ORDER.index(want)
        diff = (want_i - cur_i) % 4
        if diff == 1:
            commands.append("R")
        elif diff == 3:
            commands.append("L")
        elif diff == 2:
            commands += ["R", "R"]
        commands.append("F")
        heading = want
    return commands, heading

def turn_to_heading(commands, current_heading, desired_heading):
    cur_i = TURN_ORDER.index(current_heading)
    want_i = TURN_ORDER.index(desired_heading)
    diff = (want_i - cur_i) % 4
    if diff == 1:
        commands.append("R")
    elif diff == 3:
        commands.append("L")
    elif diff == 2:
        commands += ["R", "R"]
    return commands, desired_heading

def smooth_path_corners(path_pts, iterations=4):
    if len(path_pts) <= 2:
        return path_pts

    for _ in range(iterations):
        smoothed = [path_pts[0]]
        for i in range(len(path_pts) - 1):
            p0 = path_pts[i]
            p1 = path_pts[i + 1]
            q = (0.75 * p0[0] + 0.25 * p1[0], 0.75 * p0[1] + 0.25 * p1[1])
            r = (0.25 * p0[0] + 0.75 * p1[0], 0.25 * p0[1] + 0.75 * p1[1])
            smoothed.extend([q, r])
        smoothed.append(path_pts[-1])
        path_pts = smoothed

    return path_pts

CELL_MM = 180.0  # real-world size of one wall/cell in mm


def generate_waypoints_mm(path, cell_mm=CELL_MM, flip_xy=True):
    """Turns a cell path (list of (row, col)) into real-world millimeter
    waypoints, simplified down to just the turn points (straight-line runs
    collapse to a single start->end segment instead of one point per cell)
    -- e.g. a robot going straight through 3 cells then turning only needs
    the point where it starts and the point where it turns, not every cell
    center in between.

    cell_mm: real-world size of one cell/wall, in mm (each cell here = 180mm).
    flip_xy: if True, each point is emitted as (y, x) instead of (x, y) --
      i.e. row-based coordinate first, column-based coordinate second.

    Returns a list of (a, b) float tuples in mm, ready to format as
    {a, b} pairs.
    """
    if not path:
        return []

    # cell-center coordinates in mm: x from column, y from row
    pts_mm = [((c + 0.5) * cell_mm, (r + 0.5) * cell_mm) for r, c in path]

    # collapse collinear runs -- only keep a point where the direction of
    # travel changes (plus the first and last point)
    simplified = [pts_mm[0]]
    for i in range(1, len(pts_mm) - 1):
        x0, y0 = pts_mm[i - 1]
        x1, y1 = pts_mm[i]
        x2, y2 = pts_mm[i + 1]
        dir1 = (round(x1 - x0, 3), round(y1 - y0, 3))
        dir2 = (round(x2 - x1, 3), round(y2 - y1, 3))
        if dir1 != dir2:
            simplified.append(pts_mm[i])
    simplified.append(pts_mm[-1])

    if flip_xy:
        simplified = [(y, x) for x, y in simplified]

    return simplified


def format_waypoints_c_array(waypoints):
    """Formats a list of (a, b) tuples as a C/C++-style array literal:
        {a0, b0},
        {a1, b1},
        ...
        {aN, bN}
    """
    lines = []
    for i, (a, b) in enumerate(waypoints):
        a_str = f"{a:g}"
        b_str = f"{b:g}"
        comma = "," if i < len(waypoints) - 1 else ""
        lines.append(f"    {{{a_str}, {b_str}}}{comma}")
    return "\n".join(lines)


def generate_waypoints(path, cell_px=CELL, pad_px=PAD, smooth=True, iterations=4):
    """Turns a cell path (list of (row, col)) into actual pixel-coordinate
    waypoints on the warped/canonical image.

    Returns a list of dicts: [{"x": float, "y": float, "cell": (row, col) or None}, ...]

    - raw cell-center waypoints (smooth=False): one point per cell, straight-line
      turns -- good for a robot doing discrete grid moves (stop, turn, go).
    - smoothed waypoints (smooth=True, default): the same points run through
      the corner-smoothing spline already used for the overlay drawing, so the
      path curves through turns instead of doing sharp 90 degree corners --
      good for a robot following a continuous trajectory rather than
      stop-turn-go.
    """
    if not path:
        return []

    def nd(i, j):
        return node(i, j, cell_px, pad_px)

    # cell-center pixel coords, in path order
    raw_pts = [nd(c + 0.5, r + 0.5) for r, c in path]

    if not smooth or len(raw_pts) <= 2:
        return [{"x": float(x), "y": float(y), "cell": cell}
                for (x, y), cell in zip(raw_pts, path)]

    curvy_pts = smooth_path_corners(raw_pts, iterations=iterations)

    # only the ORIGINAL cell-center points map to a real cell; the extra
    # interpolated spline points in between don't correspond to one
    waypoints = []
    cell_lookup = {tuple(np.round(p, 3)): c for p, c in zip(raw_pts, path)}
    for p in curvy_pts:
        key = tuple(np.round(p, 3))
        waypoints.append({"x": float(p[0]), "y": float(p[1]),
                           "cell": cell_lookup.get(key)})
    return waypoints


def save_overlay(warped, ncells, h_edges, v_edges, path, circles, out_path,
                  cell_px=CELL, pad_px=PAD):
    overlay = warped.copy()

    def nd(i, j):
        p = node(i, j, cell_px, pad_px)
        return (int(p[0]), int(p[1]))

    for (i, j), val in h_edges.items():
        if val:
            cv2.line(overlay, nd(i, j), nd(i + 1, j), (0, 0, 255), 3)
    for (i, j), val in v_edges.items():
        if val:
            cv2.line(overlay, nd(i, j), nd(i, j + 1), (0, 255, 0), 3)

    if circles:
        for x, y, r in circles:
            cv2.circle(overlay, (int(x), int(y)), int(r), (0, 0, 255), -1)
            cv2.putText(overlay, "OBS", (int(x)-15, int(y)+5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 2)

    if path:
        pts_line = [nd(c + 0.5, r + 0.5) for r, c in path]
        curvy_pts = smooth_path_corners(pts_line, iterations=4)

        for i in range(len(curvy_pts) - 1):
            p1 = (int(curvy_pts[i][0]), int(curvy_pts[i][1]))
            p2 = (int(curvy_pts[i+1][0]), int(curvy_pts[i+1][1]))
            cv2.line(overlay, p1, p2, (255, 0, 255), 4)

        cv2.circle(overlay, pts_line[0], 10, (0, 200, 0), -1)
        cv2.circle(overlay, pts_line[-1], 10, (0, 0, 200), -1)

    cv2.imwrite(out_path, overlay)

def main():
    crop = load_and_crop(IMAGE_PATH)

    log_corner_orientation(crop)

    warped, H, N = detect_grid_homography(crop, ncells=GRID_CELLS)
    ncells = N - 1
    print(f"Detected grid: {N}x{N} nodes -> {ncells}x{ncells} cells")

    input_path = f"{OUTPUT_PREFIX}_input.png"
    cv2.imwrite(input_path, warped)

    h_edges, v_edges, blocked_cells, circles = detect_walls_and_obstacles(warped, ncells)

    # --- If a specific wall is STILL missing after this run, uncomment the
    # two lines below (with the correct i,j for that edge) to print its raw
    # brightness/gradient profile and see exactly why it's not triggering: ---
    # gray_dbg = cv2.cvtColor(warped, cv2.COLOR_BGR2GRAY)
    # debug_edge_profile(gray_dbg, node(4, 3), node(5, 3))

    path = astar(h_edges, v_edges, blocked_cells, START_CELL, GOAL_CELL, ncells)

    overlay_path = f"{OUTPUT_PREFIX}_overlay.png"
    save_overlay(warped, ncells, h_edges, v_edges, path, circles, overlay_path)

    combined_path = f"{OUTPUT_PREFIX}_input_vs_output.png"
    out_img = cv2.imread(overlay_path)
    combined = cv2.hconcat([warped, out_img])
    cv2.imwrite(combined_path, combined)

    if path is None:
        print("NO PATH FOUND between", START_CELL, "and", GOAL_CELL)
        open_image(combined_path)
        return

    commands, heading_after_path = path_to_commands(path, START_HEADING)
    commands, end_heading = turn_to_heading(commands, heading_after_path, END_HEADING)

    # discrete, one-point-per-cell waypoints (pixel coords on the warped image)
    waypoints_cells = generate_waypoints(path, smooth=False)
    # smoothed/curved waypoints for continuous-trajectory following
    waypoints_smooth = generate_waypoints(path, smooth=True)

    print("\nCell path:", path)
    print("\nCommand sequence:")
    print(",".join(commands))
    print("\nEnd heading:", end_heading)

    print("\nWaypoints (cell-center, pixel coords):")
    for wp in waypoints_cells:
        print(f"  ({wp['x']:.1f}, {wp['y']:.1f})  cell={wp['cell']}")

    # real-world mm waypoints, turn-points only, axes flipped (y, x) not (x, y)
    waypoints_mm = generate_waypoints_mm(path, cell_mm=CELL_MM, flip_xy=True)
    print(f"\nWaypoints (mm, {int(CELL_MM)}mm/cell, axes flipped, turn-points only):")
    print("{")
    print(format_waypoints_c_array(waypoints_mm))
    print("}")

    waypoints_txt_path = f"{OUTPUT_PREFIX}_waypoints_mm.txt"
    with open(waypoints_txt_path, "w") as f:
        f.write("{\n")
        f.write(format_waypoints_c_array(waypoints_mm))
        f.write("\n}\n")

    result_path = f"{OUTPUT_PREFIX}_result.json"
    json.dump({
        "grid_cells": ncells,
        "start": START_CELL, "goal": GOAL_CELL,
        "path": path, "commands": commands,
        "start_heading": START_HEADING,
        "end_heading": end_heading,
        "waypoints_cells": waypoints_cells,
        "waypoints_smooth": waypoints_smooth,
        "waypoints_mm": waypoints_mm,
    }, open(result_path, "w"), indent=2)

    open_image(combined_path)

if __name__ == "__main__":
    main()